<div class="relative py-12 md:py-20 overflow-hidden">
  <!-- Glowing Background Accents -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/3 left-1/3 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative text-center max-w-4xl mx-auto mb-16">
    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-semibold mb-6">
      <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span>
      Revolutionizing Recruitment
    </span>
    <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight mb-6 leading-tight">
      Scientific, Bias-Free <br/>
      <span class="bg-gradient-to-r from-indigo-400 via-purple-400 to-pink-400 bg-clip-text text-transparent">
        Talent Matching
      </span>
    </h1>
    <p class="text-lg md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed">
      Nexhire matches candidates to roles based on psychometric compatibility. Using the Big Five (OCEAN) framework, we calculate objective fit without AI bias.
    </p>

    <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
      <%= link_to "Find Your Next Role", new_user_registration_path, class: "w-full sm:w-auto px-8 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-base font-bold text-white rounded-xl shadow-lg shadow-indigo-500/25 transition-all duration-200 text-center" %>
      <%= link_to "Start Hiring", new_user_registration_path(role: :recruiter), class: "w-full sm:w-auto px-8 py-4 bg-slate-900 border border-slate-800 hover:bg-slate-800 hover:border-slate-700 text-base font-bold text-slate-200 rounded-xl transition-all duration-200 text-center" %>
    </div>
  </div>

  <!-- How It Works Section -->
  <div class="max-w-6xl mx-auto mt-24">
    <h2 class="text-3xl font-extrabold text-center text-white mb-12">How Nexhire Works</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Step 1 -->
      <div class="glass-card p-8 rounded-2xl border border-slate-800">
        <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 font-bold text-xl mb-6 shadow-md shadow-indigo-500/5">
          1
        </div>
        <h3 class="text-xl font-bold text-slate-100 mb-3">OCEAN Profile</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Applicants register and complete a 30-question Big Five personality assessment. Scores map to Openness, Conscientiousness, Extraversion, Agreeableness, and Neuroticism.
        </p>
      </div>

      <!-- Step 2 -->
      <div class="glass-card p-8 rounded-2xl border border-slate-800">
        <div class="w-12 h-12 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold text-xl mb-6 shadow-md shadow-purple-500/5">
          2
        </div>
        <h3 class="text-xl font-bold text-slate-100 mb-3">Ideal Blueprint</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Recruiters create job offers and define an ideal OCEAN score target (0–100) per dimension representing the ideal behavioral fit for their specific team culture.
        </p>
      </div>

      <!-- Step 3 -->
      <div class="glass-card p-8 rounded-2xl border border-slate-800">
        <div class="w-12 h-12 rounded-xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 font-bold text-xl mb-6 shadow-md shadow-pink-500/5">
          3
        </div>
        <h3 class="text-xl font-bold text-slate-100 mb-3">Heuristic Matching</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Candidates are ranked by a deterministic percentage score of similarity. No AI black-boxes, pure mathematical distance calculation ensuring full compliance and transparency.
        </p>
      </div>
    </div>
  </div>
</div>
