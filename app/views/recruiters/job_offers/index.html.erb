<div class="space-y-8">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-900 pb-6">
    <div>
      <h2 class="text-3xl font-extrabold text-slate-100">Recruiter Dashboard</h2>
      <p class="text-xs text-slate-400 mt-1">Manage job offers and review candidate psychometric alignment</p>
    </div>
    <%= link_to new_recruiters_job_offer_path, class: "px-5 py-3 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-xs font-bold text-white rounded-xl shadow-lg shadow-indigo-500/25 transition-all flex items-center gap-2" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
      </svg>
      Post a Job Offer
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @job_offers.any? %>
      <% @job_offers.each do |job| %>
        <div class="glass-card p-6 rounded-2xl border border-slate-800 flex flex-col justify-between hover:border-slate-700 hover:shadow-2xl transition-all duration-300">
          
          <div class="space-y-4">
            <div>
              <span class="text-xs text-slate-500 font-semibold block">Posted on <%= job.created_at.strftime("%b %d, %Y") %></span>
              <h3 class="text-lg font-bold text-slate-100 mt-1 leading-snug"><%= job.title %></h3>
              <p class="text-xs text-indigo-400 font-bold mt-1"><%= job.company_name %></p>
            </div>

            <div class="flex items-center gap-4 py-2 border-y border-slate-900">
              <div class="flex-grow">
                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Applicants</span>
                <span class="text-xl font-black text-slate-200"><%= job.job_applications.count %></span>
              </div>
              <div class="h-8 w-px bg-slate-900"></div>
              <div class="flex-grow">
                <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Avg. Match</span>
                <% if job.job_applications.any? %>
                  <% avg_match = (job.job_applications.to_a.sum(&:match_percentage) / job.job_applications.count.to_f).round(1) %>
                  <span class="text-xl font-black text-emerald-400"><%= avg_match %>%</span>
                <% else %>
                  <span class="text-sm font-semibold text-slate-500">N/A</span>
                <% end %>
              </div>
            </div>

            <!-- Ideal OCEAN targets preview badge style -->
            <div class="space-y-2">
              <span class="text-[9px] text-slate-500 font-bold uppercase tracking-wider block">OCEAN Blueprints</span>
              <div class="flex flex-wrap gap-1 text-[9px] font-bold">
                <span class="px-2 py-0.5 rounded bg-cyan-950/40 text-cyan-400 border border-cyan-500/10">O: <%= job.ideal_openness %></span>
                <span class="px-2 py-0.5 rounded bg-indigo-950/40 text-indigo-400 border border-indigo-500/10">C: <%= job.ideal_conscientiousness %></span>
                <span class="px-2 py-0.5 rounded bg-amber-950/40 text-amber-400 border border-amber-500/10">E: <%= job.ideal_extraversion %></span>
                <span class="px-2 py-0.5 rounded bg-emerald-950/40 text-emerald-400 border border-emerald-500/10">A: <%= job.ideal_agreeableness %></span>
                <span class="px-2 py-0.5 rounded bg-rose-950/40 text-rose-400 border border-rose-500/10">N: <%= job.ideal_neuroticism %></span>
              </div>
            </div>
          </div>

          <div class="pt-6 border-t border-slate-900 mt-6 flex gap-2">
            <%= link_to "View Applicants", recruiters_job_offer_path(job), class: "flex-grow py-2 bg-indigo-600 hover:bg-indigo-700 text-xs font-bold text-white text-center rounded-xl transition-colors" %>
            <%= link_to edit_recruiters_job_offer_path(job), class: "p-2 bg-slate-900 border border-slate-800 hover:bg-slate-850 text-slate-300 rounded-xl transition-colors flex items-center justify-center" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
              </svg>
            <% end %>
            <%= button_to recruiters_job_offer_path(job), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this job offer? All applications will be lost." }, class: "p-2 bg-slate-900 border border-slate-850 hover:bg-slate-850 hover:text-rose-400 text-slate-500 rounded-xl transition-colors flex items-center justify-center cursor-pointer" do %>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
              </svg>
            <% end %>
          </div>

        </div>
      <% end %>
    <% else %>
      <div class="col-span-full glass-card p-12 text-center border border-slate-850 rounded-2xl">
        <p class="text-slate-500 text-sm mb-4">You haven't posted any job offers yet.</p>
        <%= link_to "Post Your First Job", new_recruiters_job_offer_path, class: "px-6 py-2.5 bg-indigo-650 hover:bg-indigo-700 text-xs font-bold text-white rounded-xl transition-colors inline-block" %>
      </div>
    <% end %>
  </div>
</div>
