<div class="space-y-6">
  
  <%= link_to recruiters_job_offer_path(@job_offer), class: "inline-flex items-center gap-1.5 text-xs font-bold text-slate-400 hover:text-white transition-colors mb-2" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
    </svg>
    Back to Offer Applications
  <% end %>

  <!-- Profile Review Header Card -->
  <div class="glass p-6 rounded-2xl border border-slate-800 shadow-xl flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
    <div class="flex items-center gap-4">
      <% if @profile.photo.attached? %>
        <%= image_tag @profile.photo, class: "w-16 h-16 rounded-full object-cover border-2 border-indigo-500 shadow-lg shadow-indigo-500/10" %>
      <% else %>
        <div class="w-16 h-16 rounded-full bg-gradient-to-tr from-indigo-500 to-purple-650 flex items-center justify-center font-black text-2xl text-white border-2 border-indigo-400 shadow-lg shadow-indigo-500/10">
          <%= @profile.name[0..1].upcase %>
        </div>
      <% end %>
      
      <div>
        <div class="flex items-center gap-2">
          <h2 class="text-2xl font-extrabold text-slate-100"><%= @profile.name %></h2>
          <span class="px-2.5 py-0.5 text-[10px] font-bold rounded-full bg-slate-900 border border-slate-800 text-slate-400">
            Candidate
          </span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Applying for: <span class="font-bold text-slate-200"><%= @job_offer.title %></span></p>
      </div>
    </div>

    <!-- Application Status Controls -->
    <div class="flex flex-wrap items-center gap-2 w-full md:w-auto border-t border-slate-900 md:border-0 pt-4 md:pt-0">
      <span class="text-xs font-semibold text-slate-400 mr-2 block w-full md:w-auto">Update Status:</span>
      
      <%= button_to "Review", update_status_recruiters_job_offer_job_application_path(@job_offer, @job_application, status: 'reviewed'), method: :patch, class: "px-3.5 py-2 bg-slate-900 hover:bg-amber-500/10 border border-slate-800 text-amber-400 hover:border-amber-500/30 text-xs font-bold rounded-xl transition-all cursor-pointer" %>
      
      <%= button_to "Accept", update_status_recruiters_job_offer_job_application_path(@job_offer, @job_application, status: 'accepted'), method: :patch, class: "px-3.5 py-2 bg-slate-900 hover:bg-emerald-500/10 border border-slate-800 text-emerald-400 hover:border-emerald-500/30 text-xs font-bold rounded-xl transition-all cursor-pointer" %>
      
      <%= button_to "Reject", update_status_recruiters_job_offer_job_application_path(@job_offer, @job_application, status: 'rejected'), method: :patch, class: "px-3.5 py-2 bg-slate-900 hover:bg-rose-500/10 border border-slate-800 text-rose-450 hover:border-rose-500/30 text-xs font-bold rounded-xl transition-all cursor-pointer" %>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
    
    <!-- Left Column: OCEAN Snapshot & Skills -->
    <div class="space-y-6">
      
      <!-- Match Card -->
      <div class="glass p-6 rounded-2xl border border-slate-800 shadow-xl space-y-6">
        <h3 class="text-sm font-extrabold text-slate-400 uppercase tracking-wider">Candidate Match Breakdown</h3>

        <div class="p-5 rounded-xl border border-slate-850 bg-slate-950/20 text-center space-y-2">
          <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider block">Match Score</span>
          <% match = @job_application.match_percentage %>
          <% match_color = match >= 80 ? 'text-emerald-400 border-emerald-500/20 bg-emerald-500/5' : (match >= 60 ? 'text-amber-400 border-amber-500/20 bg-amber-500/5' : 'text-rose-400 border-rose-500/20 bg-rose-500/5') %>
          <span class="inline-block text-3xl font-black px-6 py-2 rounded-2xl border <%= match_color %>">
            <%= match %>%
          </span>
        </div>

        <div class="space-y-4">
          <% ocean = @job_application.ocean_snapshot %>
          <% [
            { name: "Openness", val: ocean["openness"].to_i, target: @job_offer.ideal_openness, color: "bg-cyan-500", text: "text-cyan-400" },
            { name: "Conscientiousness", val: ocean["conscientiousness"].to_i, target: @job_offer.ideal_conscientiousness, color: "bg-indigo-500", text: "text-indigo-400" },
            { name: "Extraversion", val: ocean["extraversion"].to_i, target: @job_offer.ideal_extraversion, color: "bg-amber-500", text: "text-amber-400" },
            { name: "Agreeableness", val: ocean["agreeableness"].to_i, target: @job_offer.ideal_agreeableness, color: "bg-emerald-500", text: "text-emerald-400" },
            { name: "Neuroticism", val: ocean["neuroticism"].to_i, target: @job_offer.ideal_neuroticism, color: "bg-rose-500", text: "text-rose-400" }
          ].each do |dim| %>
            <div class="space-y-1">
              <div class="flex justify-between text-xs text-slate-400 font-semibold">
                <span><%= dim[:name] %></span>
                <span>Score: <strong class="text-slate-200"><%= dim[:val] %>%</strong> &middot; Target: <strong class="text-slate-200"><%= dim[:target] %>%</strong></span>
              </div>
              
              <div class="relative h-1.5 w-full bg-slate-900 rounded-full border border-slate-850 overflow-hidden">
                <!-- Target Bar -->
                <div class="absolute top-0 bottom-0 left-0 bg-slate-850 opacity-60 rounded-full" style="width: <%= dim[:target] %>%"></div>
                <!-- Candidate Bar -->
                <div class="absolute top-0 bottom-0 left-0 <%= dim[:color] %> rounded-full" style="width: <%= dim[:val] %>%"></div>
              </div>
            </div>
          <% end %>
        </div>

        <div class="border-t border-slate-900 pt-4 text-[10px] text-slate-500 text-center leading-normal">
          OCEAN score snapshot frozen at time of application on <%= @job_application.created_at.strftime("%B %d, %Y") %>
        </div>
      </div>

      <!-- Skills Card -->
      <div class="glass p-6 rounded-2xl border border-slate-800 shadow-xl space-y-4">
        <h3 class="text-sm font-extrabold text-slate-400 uppercase tracking-wider">Applicant Skills</h3>
        <div class="flex flex-wrap gap-1.5">
          <% if @profile.skill_list.any? %>
            <% @profile.skill_list.each do |skill| %>
              <span class="px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-900 border border-slate-800 text-indigo-300">
                <%= skill %>
              </span>
            <% end %>
          <% else %>
            <span class="text-slate-500 text-xs">No skills listed.</span>
          <% end %>
        </div>
      </div>

    </div>

    <!-- Right Column: Work History & Education -->
    <div class="lg:col-span-2 space-y-6">
      
      <!-- Work Experience -->
      <div class="glass p-6 rounded-2xl border border-slate-800 shadow-xl">
        <h3 class="text-lg font-bold text-slate-100 mb-4">Work Experience</h3>
        
        <div class="space-y-4">
          <% if @profile.work_experiences.any? %>
            <% @profile.work_experiences.each do |work| %>
              <div class="p-4 rounded-xl border border-slate-850 bg-slate-900/10">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-sm font-bold text-indigo-400"><%= work.company %></span>
                  <span class="text-slate-700">&middot;</span>
                  <span class="text-xs font-semibold bg-slate-800 text-slate-300 px-2.5 py-0.5 rounded-full"><%= work.position %></span>
                </div>
                <p class="text-[10px] text-slate-500 mb-2">
                  <%= work.start_date.strftime("%B %Y") %> &ndash; 
                  <%= work.current? ? "Present" : work.end_date&.strftime("%B %Y") %>
                </p>
                <% if work.description.present? %>
                  <p class="text-xs text-slate-300 leading-relaxed whitespace-pre-wrap"><%= work.description %></p>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-slate-500 text-xs py-4 text-center">
              No work experiences listed.
            </div>
          <% end %>
        </div>
      </div>

      <!-- Education -->
      <div class="glass p-6 rounded-2xl border border-slate-800 shadow-xl">
        <h3 class="text-lg font-bold text-slate-100 mb-4">Education</h3>
        
        <div class="space-y-4">
          <% if @profile.educations.any? %>
            <% @profile.educations.each do |edu| %>
              <div class="p-4 rounded-xl border border-slate-850 bg-slate-900/10">
                <div class="flex items-center gap-2 mb-1">
                  <span class="text-sm font-bold text-purple-400"><%= edu.school %></span>
                  <span class="text-slate-700">&middot;</span>
                  <span class="text-xs font-semibold bg-slate-800 text-slate-300 px-2.5 py-0.5 rounded-full"><%= edu.degree %></span>
                </div>
                <p class="text-xs text-slate-400 mb-1"><%= edu.field_of_study %></p>
                <p class="text-[10px] text-slate-500 mb-2">
                  <%= edu.start_date.strftime("%Y") %> &ndash; <%= edu.end_date&.strftime("%Y") || "Present" %>
                </p>
                <% if edu.description.present? %>
                  <p class="text-xs text-slate-300 leading-relaxed whitespace-pre-wrap"><%= edu.description %></p>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <div class="text-slate-500 text-xs py-4 text-center">
              No education entries listed.
            </div>
          <% end %>
        </div>
      </div>

    </div>

  </div>
</div>
