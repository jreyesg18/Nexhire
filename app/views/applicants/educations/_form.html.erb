<%= form_with(model: [:applicants, new_education], id: "new-education-form", class: "space-y-4") do |f| %>
  <% if new_education.errors.any? %>
    <div class="p-3.5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs">
      <p class="font-bold mb-1">Could not add education:</p>
      <ul class="list-disc pl-4 space-y-0.5">
        <% new_education.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="sm:col-span-2">
      <%= f.label :school, class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.text_field :school, placeholder: "e.g. Stanford University", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
    <div>
      <%= f.label :degree, class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.text_field :degree, placeholder: "e.g. B.S. or MS", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :field_of_study, "Field of Study", class: "block text-xs font-semibold text-slate-400 mb-1" %>
    <%= f.text_field :field_of_study, placeholder: "e.g. Computer Science", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :start_date, "Start Date", class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.date_field :start_date, class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
    <div>
      <%= f.label :end_date, "End Date (Expected / Actual)", class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.date_field :end_date, class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
  </div>

  <div>
    <%= f.label :description, "Description / Key Activities", class: "block text-xs font-semibold text-slate-400 mb-1" %>
    <%= f.text_area :description, rows: 3, placeholder: "Thesis, notable clubs, or specializations...", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
  </div>

  <div class="flex justify-end">
    <%= f.submit "Add Education", class: "px-4 py-2 bg-purple-600 hover:bg-purple-700 text-xs font-bold text-white rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
