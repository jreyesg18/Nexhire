<%= content_tag :div, id: dom_id(education), class: "glass-card p-5 rounded-xl border border-slate-800 flex justify-between items-start gap-4 transition-all duration-200" do %>
  <div class="flex-grow">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-sm font-bold text-purple-400"><%= education.school %></span>
      <span class="text-slate-700">&middot;</span>
      <span class="text-xs font-semibold bg-slate-800 text-slate-300 px-2.5 py-0.5 rounded-full"><%= education.degree %></span>
    </div>
    <p class="text-xs text-slate-400 mb-2"><%= education.field_of_study %></p>
    <p class="text-xs text-slate-500 mb-3">
      <%= education.start_date.strftime("%Y") %> &ndash; <%= education.end_date&.strftime("%Y") || "Present" %>
    </p>
    <% if education.description.present? %>
      <p class="text-sm text-slate-300 leading-relaxed whitespace-pre-wrap"><%= education.description %></p>
    <% end %>
  </div>
  <%= button_to applicants_education_path(education), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this education entry?" }, class: "text-slate-500 hover:text-rose-400 p-1.5 rounded-lg hover:bg-slate-800/80 transition-all cursor-pointer" do %>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
    </svg>
  <% end %>
<% end %>
