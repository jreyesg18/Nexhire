<%= form_with(model: [:applicants, new_work_experience], id: "new-work-experience-form", class: "space-y-4") do |f| %>
  <% if new_work_experience.errors.any? %>
    <div class="p-3.5 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-xs">
      <p class="font-bold mb-1">Could not add experience:</p>
      <ul class="list-disc pl-4 space-y-0.5">
        <% new_work_experience.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :company, class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.text_field :company, placeholder: "e.g. Google", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
    <div>
      <%= f.label :position, class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.text_field :position, placeholder: "e.g. Software Engineer", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= f.label :start_date, "Start Date", class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.date_field :start_date, class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
    <div>
      <%= f.label :end_date, "End Date", class: "block text-xs font-semibold text-slate-400 mb-1" %>
      <%= f.date_field :end_date, class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
    </div>
  </div>

  <div class="flex items-center">
    <%= f.check_box :current, class: "w-4 h-4 rounded border-slate-700 bg-slate-900 text-indigo-600 focus:ring-indigo-500 focus:ring-offset-slate-950" %>
    <%= f.label :current, "I currently work here", class: "ml-2 text-xs text-slate-300 select-none cursor-pointer" %>
  </div>

  <div>
    <%= f.label :description, "Description / Key Achievements", class: "block text-xs font-semibold text-slate-400 mb-1" %>
    <%= f.text_area :description, rows: 3, placeholder: "Describe your impact and responsibilities...", class: "glass-input w-full px-3 py-2 rounded-lg text-sm" %>
  </div>

  <div class="flex justify-end">
    <%= f.submit "Add Experience", class: "px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-xs font-bold text-white rounded-lg transition-colors cursor-pointer" %>
  </div>
<% end %>
