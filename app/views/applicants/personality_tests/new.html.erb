<div class="max-w-3xl mx-auto">
  
  <div class="mb-8 text-center">
    <h2 class="text-3xl font-extrabold text-slate-100">OCEAN Psychometric Assessment</h2>
    <p class="text-sm text-slate-400 mt-2">
      Answer all 30 statements based on how you actually behave, not how you wish to behave.
    </p>
  </div>

  <%= form_with(url: applicants_personality_test_path, method: :post, local: true, class: "space-y-6") do %>
    
    <% @questions.each_with_index do |q, index| %>
      <div class="glass-card p-6 rounded-2xl border border-slate-800 space-y-4 hover:border-indigo-500/30 transition-colors">
        <div class="flex items-start gap-4">
          <span class="w-7 h-7 rounded-lg bg-slate-900 border border-slate-850 flex items-center justify-center font-bold text-xs text-slate-400">
            <%= index + 1 %>
          </span>
          <p class="text-base text-slate-200 font-medium pt-0.5"><%= q[:text] %></p>
        </div>

        <!-- Likert 1-5 Scale -->
        <div class="pt-2">
          <div class="flex items-center justify-between gap-2 max-w-lg mx-auto">
            <span class="text-[10px] font-bold text-slate-500 uppercase w-20 text-right hidden sm:block">Disagree</span>
            
            <div class="flex items-center justify-between flex-grow px-2 sm:px-6">
              <% (1..5).each do |score| %>
                <label class="flex flex-col items-center cursor-pointer group">
                  <%= radio_button_tag "responses[#{q[:id]}]", score, false, class: "sr-only peer", required: true %>
                  <div class="w-10 h-10 rounded-full border border-slate-700 bg-slate-950/80 flex items-center justify-center text-sm font-bold text-slate-400 peer-checked:bg-indigo-600 peer-checked:border-indigo-500 peer-checked:text-white group-hover:border-slate-500 transition-all select-none">
                    <%= score %>
                  </div>
                  <span class="text-[9px] text-slate-500 mt-1 font-semibold opacity-0 group-hover:opacity-100 transition-opacity">
                    <% if score == 1 %>Strongly Disagree<% elsif score == 2 %>Disagree<% elsif score == 3 %>Neutral<% elsif score == 4 %>Agree<% elsif score == 5 %>Strongly Agree<% end %>
                  </span>
                </label>
              <% end %>
            </div>

            <span class="text-[10px] font-bold text-slate-500 uppercase w-20 text-left hidden sm:block">Agree</span>
          </div>
          
          <!-- Mobile labels -->
          <div class="flex justify-between text-[10px] font-bold text-slate-500 uppercase sm:hidden pt-1 px-4">
            <span>Disagree</span>
            <span>Agree</span>
          </div>
        </div>
      </div>
    <% end %>

    <div class="pt-6 pb-12 flex justify-center">
      <%= submit_tag "Submit Personality Assessment", class: "px-10 py-4 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-sm font-extrabold text-white rounded-xl shadow-lg shadow-indigo-500/25 transition-all duration-200 cursor-pointer text-center" %>
    </div>
  <% end %>

</div>
