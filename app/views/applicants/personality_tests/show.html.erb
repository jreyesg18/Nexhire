<div class="max-w-4xl mx-auto">
  
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <h2 class="text-3xl font-extrabold text-slate-100">Big Five (OCEAN) Profile</h2>
      <p class="text-xs text-slate-400 mt-1">Your psychometric behavioral blueprint</p>
    </div>
    
    <% if @latest_result && !@latest_result.expired? %>
      <%= link_to "Retake Assessment", new_applicants_personality_test_path, class: "px-5 py-2.5 bg-slate-900 hover:bg-slate-800 border border-slate-800 rounded-xl text-xs font-bold text-slate-200 transition-colors text-center cursor-pointer" %>
    <% end %>
  </div>

  <% if @latest_result.nil? %>
    <!-- Empty State -->
    <div class="glass p-8 md:p-12 rounded-2xl border border-slate-800 text-center shadow-xl space-y-6">
      <div class="w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 mx-auto shadow-md">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
        </svg>
      </div>
      <div class="max-w-md mx-auto space-y-2">
        <h3 class="text-2xl font-bold text-slate-100">Assessment Required</h3>
        <p class="text-sm text-slate-400">
          You haven't completed the Big Five personality test yet. To unlock job applications and stand out to recruiters, complete the 30-question assessment.
        </p>
      </div>
      <div class="pt-4">
        <%= link_to "Start Assessment Now", new_applicants_personality_test_path, class: "px-8 py-3.5 bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-sm font-bold text-white rounded-xl shadow-lg shadow-indigo-500/25 transition-all cursor-pointer inline-block" %>
      </div>
    </div>

  <% elsif @latest_result.expired? %>
    <!-- Expired State -->
    <div class="glass p-8 rounded-2xl border border-rose-500/20 text-center shadow-xl space-y-6 bg-rose-950/5">
      <div class="w-16 h-16 rounded-2xl bg-rose-500/10 border border-rose-500/20 flex items-center justify-center text-rose-400 mx-auto shadow-md">
        <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div class="max-w-md mx-auto space-y-2">
        <h3 class="text-2xl font-bold text-slate-100">Your Test Has Expired</h3>
        <p class="text-sm text-slate-400">
          Your personality test results are older than 90 days (completed on <%= @latest_result.completed_at.strftime("%B %d, %Y") %>). You must retake the test to apply for new roles.
        </p>
      </div>
      <div class="pt-4">
        <%= link_to "Retake Assessment", new_applicants_personality_test_path, class: "px-8 py-3.5 bg-gradient-to-r from-rose-500 to-purple-600 hover:from-rose-600 hover:to-purple-700 text-sm font-bold text-white rounded-xl shadow-lg shadow-rose-500/25 transition-all cursor-pointer inline-block" %>
      </div>
    </div>

  <% else %>
    <!-- Valid Test Results Dashboard -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      
      <!-- General Test Status Info -->
      <div class="md:col-span-1 glass-card p-6 rounded-2xl border border-slate-800 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-extrabold text-indigo-400 uppercase tracking-widest block mb-2">Test Validity</span>
          <h4 class="text-xl font-bold text-slate-100 mb-2">Profile Status: Active</h4>
          <p class="text-xs text-slate-400 leading-relaxed mb-4">
            Nexhire profiles require retaking the test every 90 days to keep results fresh and relevant to your professional development.
          </p>
        </div>
        
        <div class="border-t border-slate-800 pt-4 mt-4">
          <div class="flex justify-between items-center text-xs text-slate-400 mb-1">
            <span>Completed On:</span>
            <span class="font-semibold text-slate-200"><%= @latest_result.completed_at.strftime("%b %d, %Y") %></span>
          </div>
          <% days_remaining = (90 - (Time.current.to_date - @latest_result.completed_at.to_date).to_i) %>
          <div class="flex justify-between items-center text-xs text-slate-400">
            <span>Expires In:</span>
            <span class="font-bold <%= days_remaining < 15 ? 'text-rose-400' : 'text-emerald-400' %>"><%= days_remaining %> Days</span>
          </div>
        </div>
      </div>

      <!-- OCEAN Scores Breakdown -->
      <div class="md:col-span-2 glass p-6 rounded-2xl border border-slate-800 shadow-xl space-y-6">
        <h4 class="text-sm font-extrabold text-slate-400 uppercase tracking-wider mb-2">Your Dimensional Scores</h4>

        <!-- Dimension 1: Openness -->
        <div>
          <div class="flex justify-between items-center text-sm font-bold text-slate-200 mb-1.5">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-cyan-500"></span>
              Openness to Experience
            </span>
            <span class="text-cyan-400"><%= @latest_result.openness %>%</span>
          </div>
          <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div class="bg-cyan-500 h-full rounded-full transition-all duration-1000" style="width: <%= @latest_result.openness %>%"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-1 block">Curiosity, imagination, and preference for novelty.</span>
        </div>

        <!-- Dimension 2: Conscientiousness -->
        <div>
          <div class="flex justify-between items-center text-sm font-bold text-slate-200 mb-1.5">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-indigo-500"></span>
              Conscientiousness
            </span>
            <span class="text-indigo-400"><%= @latest_result.conscientiousness %>%</span>
          </div>
          <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div class="bg-indigo-500 h-full rounded-full transition-all duration-1000" style="width: <%= @latest_result.conscientiousness %>%"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-1 block">Organization, discipline, goal-driven planning.</span>
        </div>

        <!-- Dimension 3: Extraversion -->
        <div>
          <div class="flex justify-between items-center text-sm font-bold text-slate-200 mb-1.5">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-amber-500"></span>
              Extraversion
            </span>
            <span class="text-amber-400"><%= @latest_result.extraversion %>%</span>
          </div>
          <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div class="bg-amber-500 h-full rounded-full transition-all duration-1000" style="width: <%= @latest_result.extraversion %>%"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-1 block">Social energy, assertiveness, and assertiveness.</span>
        </div>

        <!-- Dimension 4: Agreeableness -->
        <div>
          <div class="flex justify-between items-center text-sm font-bold text-slate-200 mb-1.5">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
              Agreeableness
            </span>
            <span class="text-emerald-400"><%= @latest_result.agreeableness %>%</span>
          </div>
          <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div class="bg-emerald-500 h-full rounded-full transition-all duration-1000" style="width: <%= @latest_result.agreeableness %>%"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-1 block">Trust, empathy, collaboration, and harmony.</span>
        </div>

        <!-- Dimension 5: Neuroticism -->
        <div>
          <div class="flex justify-between items-center text-sm font-bold text-slate-200 mb-1.5">
            <span class="flex items-center gap-2">
              <span class="w-3 h-3 rounded-full bg-rose-500"></span>
              Emotional Stability (Neuroticism)
            </span>
            <span class="text-rose-400"><%= @latest_result.neuroticism %>%</span>
          </div>
          <div class="w-full bg-slate-900 h-2.5 rounded-full overflow-hidden border border-slate-800">
            <div class="bg-rose-500 h-full rounded-full transition-all duration-1000" style="width: <%= @latest_result.neuroticism %>%"></div>
          </div>
          <span class="text-[10px] text-slate-500 mt-1 block">Vulnerability to stress, mood swings, anxiety.</span>
        </div>

      </div>

    </div>
  <% end %>

</div>
