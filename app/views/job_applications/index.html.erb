<div class="space-y-8">
  <div class="flex justify-between items-center border-b border-slate-900 pb-6">
    <div>
      <h2 class="text-3xl font-extrabold text-slate-100">My Job Applications</h2>
      <p class="text-xs text-slate-400 mt-1">Track the status of your psychometrically aligned applications</p>
    </div>
  </div>

  <div class="space-y-4">
    <% if @job_applications.any? %>
      <% @job_applications.each do |app| %>
        <div class="glass-card p-6 rounded-2xl border border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 hover:border-slate-700 transition-colors">
          
          <div class="space-y-2">
            <span class="text-xs text-indigo-400 font-bold block"><%= app.job_offer.company_name %></span>
            <h3 class="text-lg font-bold text-slate-100 mt-0.5"><%= app.job_offer.title %></h3>
            
            <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 font-semibold">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Applied on <%= app.created_at.strftime("%b %d, %Y") %>
              </span>
              <span>&middot;</span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                <%= app.job_offer.location %>
              </span>
            </div>
          </div>

          <!-- Match % & Status Indicators -->
          <div class="flex items-center gap-4 w-full sm:w-auto justify-between sm:justify-end border-t border-slate-900 sm:border-0 pt-4 sm:pt-0">
            
            <!-- Snapshot match score -->
            <div class="flex flex-col items-center">
              <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-1">Match Score</span>
              <span class="text-base font-black px-3 py-1 rounded-xl bg-slate-900 border border-slate-800 text-indigo-300">
                <%= app.match_percentage %>%
              </span>
            </div>

            <!-- Status -->
            <div class="flex flex-col items-end">
              <span class="text-[10px] text-slate-500 font-bold uppercase tracking-wider mb-1">Status</span>
              <% status_class = case app.status
                 when 'pending' then 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20'
                 when 'reviewed' then 'bg-amber-500/10 text-amber-400 border-amber-500/20'
                 when 'accepted' then 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'
                 when 'rejected' then 'bg-rose-500/10 text-rose-400 border-rose-500/20'
                 else 'bg-slate-900 text-slate-400 border-slate-800'
                 end
              %>
              <span class="px-3.5 py-1 text-xs font-bold rounded-full border <%= status_class %>">
                <%= app.status.capitalize %>
              </span>
            </div>

            <div class="pl-2">
              <%= link_to job_offer_path(app.job_offer), class: "p-2 rounded-xl bg-slate-900 border border-slate-800 hover:bg-slate-800 hover:text-white text-slate-400 transition-all flex items-center justify-center" do %>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
                </svg>
              <% end %>
            </div>

          </div>

        </div>
      <% end %>
    <% else %>
      <div class="glass-card p-12 text-center border border-slate-850 rounded-2xl">
        <p class="text-slate-500 text-sm mb-4">You haven't submitted any job applications yet.</p>
        <%= link_to "Find Jobs", job_offers_path, class: "px-6 py-2.5 bg-indigo-650 hover:bg-indigo-700 text-xs font-bold text-white rounded-xl transition-colors inline-block" %>
      </div>
    <% end %>
  </div>
</div>
