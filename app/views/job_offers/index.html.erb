<div class="space-y-8">
  <div class="flex justify-between items-center border-b border-slate-900 pb-6">
    <div>
      <h2 class="text-3xl font-extrabold text-slate-100">Explore Job Opportunities</h2>
      <p class="text-xs text-slate-400 mt-1">Browse openings matching your personal psychometric profile</p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if @job_offers.any? %>
      <% @job_offers.each do |job| %>
        <div class="glass-card p-6 rounded-2xl border border-slate-800 flex flex-col justify-between hover:border-slate-700 hover:shadow-2xl transition-all duration-300">
          
          <div class="space-y-4">
            <!-- Header -->
            <div class="flex justify-between items-start gap-3">
              <div>
                <span class="text-xs text-indigo-400 font-bold block"><%= job.company_name %></span>
                <h3 class="text-lg font-bold text-slate-100 mt-1 leading-snug"><%= job.title %></h3>
              </div>
              
              <!-- Match Percentage (if applicant is logged in) -->
              <% if user_signed_in? && current_user.applicant? %>
                <% if current_user.has_valid_test_result? %>
                  <% match = job.match_percentage_for_user(current_user) %>
                  <% match_class = match >= 80 ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/25' : (match >= 60 ? 'bg-amber-500/10 text-amber-400 border-amber-500/25' : 'bg-rose-500/10 text-rose-400 border-rose-500/25') %>
                  <div class="flex flex-col items-center px-3 py-1.5 rounded-xl border <%= match_class %> text-center">
                    <span class="text-[10px] uppercase font-bold tracking-wider">Match</span>
                    <span class="text-sm font-black"><%= match %>%</span>
                  </div>
                <% else %>
                  <div class="flex flex-col items-center px-3 py-1.5 rounded-xl border border-rose-500/20 bg-rose-500/10 text-rose-400 text-center">
                    <span class="text-[9px] uppercase font-extrabold leading-tight">Test</span>
                    <span class="text-[9px] font-semibold">Expired</span>
                  </div>
                <% end %>
              <% end %>
            </div>

            <!-- Details -->
            <div class="flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-slate-500 font-semibold">
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <%= job.location %>
              </span>
              <span class="flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-slate-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                <%= job.salary %>
              </span>
            </div>

            <p class="text-sm text-slate-400 line-clamp-3 leading-relaxed">
              <%= job.description %>
            </p>
          </div>

          <div class="pt-6 border-t border-slate-900 mt-6">
            <%= link_to "View Details", job_offer_path(job), class: "block w-full py-2.5 bg-slate-900 border border-slate-800 hover:bg-slate-850 hover:text-white rounded-xl text-xs font-bold text-slate-300 text-center transition-colors" %>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="col-span-full glass-card p-12 text-center border border-slate-850 rounded-2xl">
        <p class="text-slate-500 text-sm">No job offers available right now. Check back later!</p>
      </div>
    <% end %>
  </div>
</div>
